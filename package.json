{
  "name": "@johnmorrisdotca/kazu",
  "version": "1.1.0",
  "description": "Grid number and logic puzzles for JavaScript and TypeScript: Sudoku and its variants, Futoshiki, Skyscrapers, Shikaku, Hitori, Nurikabe, Akari, Juosan and Slitherlink. Dedicated typed engines, independently checked puzzles, SVG boards and bilingual touch and keyboard players. Zero runtime dependencies.",
  "keywords": [
    "puzzle",
    "sudoku",
    "number-place",
    "killer-sudoku",
    "jigsaw-sudoku",
    "sudoku-x",
    "futoshiki",
    "skyscrapers",
    "logic-puzzle",
    "puzzle-generator",
    "puzzle-solver",
    "seeded-random",
    "svg",
    "custom-element",
    "web-component",
    "typescript",
    "javascript",
    "zero-dependencies",
    "browser",
    "node",
    "itsutsu",
    "shikaku",
    "hitori",
    "nurikabe",
    "akari",
    "light-puzzle",
    "juosan",
    "slitherlink"
  ],
  "homepage": "https://github.com/johnmorrisdotca/kazu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/kazu.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/kazu/issues"
  },
  "author": "John Morris",
  "license": "MIT",
